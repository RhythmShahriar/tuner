{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The required fields of SARIF 2.1.0 (OASIS sarif-schema-2.1.0.json) for the objects Tuner writes, plus the members GitHub code scanning reads. Tests only.",
  "type": "object",
  "required": ["version", "runs"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "enum": ["2.1.0"] },
    "runs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/run" } }
  },
  "$defs": {
    "run": {
      "type": "object",
      "required": ["tool"],
      "properties": {
        "tool": { "$ref": "#/$defs/tool" },
        "invocations": { "type": "array", "items": { "$ref": "#/$defs/invocation" } },
        "originalUriBaseIds": { "type": "object", "additionalProperties": { "$ref": "#/$defs/artifactLocation" } },
        "results": { "type": "array", "items": { "$ref": "#/$defs/result" } }
      }
    },
    "tool": {
      "type": "object",
      "required": ["driver"],
      "properties": { "driver": { "$ref": "#/$defs/toolComponent" } }
    },
    "toolComponent": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "informationUri": { "type": "string" },
        "rules": { "type": "array", "items": { "$ref": "#/$defs/reportingDescriptor" } }
      }
    },
    "reportingDescriptor": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "shortDescription": { "$ref": "#/$defs/message" },
        "fullDescription": { "$ref": "#/$defs/message" },
        "help": { "$ref": "#/$defs/message" },
        "helpUri": { "type": "string", "pattern": "^https://" },
        "properties": { "type": "object" }
      }
    },
    "invocation": {
      "type": "object",
      "required": ["executionSuccessful"],
      "properties": {
        "executionSuccessful": { "type": "boolean" },
        "toolExecutionNotifications": { "type": "array", "items": { "$ref": "#/$defs/notification" } }
      }
    },
    "notification": {
      "type": "object",
      "required": ["message"],
      "properties": {
        "level": { "type": "string", "enum": ["none", "note", "warning", "error"] },
        "message": { "$ref": "#/$defs/message" }
      }
    },
    "message": {
      "type": "object",
      "anyOf": [{ "required": ["text"] }, { "required": ["id"] }],
      "properties": { "text": { "type": "string" }, "id": { "type": "string" } }
    },
    "result": {
      "type": "object",
      "required": ["message", "ruleId", "locations", "partialFingerprints"],
      "properties": {
        "ruleId": { "type": "string" },
        "level": { "type": "string", "enum": ["none", "note", "warning", "error"] },
        "message": { "$ref": "#/$defs/message" },
        "locations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/location" } },
        "partialFingerprints": { "type": "object", "required": ["tunerFinding/v1"], "additionalProperties": { "type": "string" } },
        "properties": { "type": "object" }
      }
    },
    "location": {
      "type": "object",
      "properties": { "physicalLocation": { "$ref": "#/$defs/physicalLocation" } }
    },
    "physicalLocation": {
      "type": "object",
      "anyOf": [{ "required": ["address"] }, { "required": ["artifactLocation"] }],
      "properties": {
        "artifactLocation": { "$ref": "#/$defs/artifactLocation" },
        "region": { "type": "object", "properties": { "startLine": { "type": "integer", "minimum": 1 } } }
      }
    },
    "artifactLocation": {
      "type": "object",
      "properties": { "uri": { "type": "string" }, "uriBaseId": { "type": "string" } }
    }
  }
}
